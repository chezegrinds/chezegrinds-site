{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.exceedmaths.ie/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.exceedmaths.ie/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.mp4",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/(.*)\\.mov",
      "headers": [
        { "key": "Content-Type", "value": "video/quicktime" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
